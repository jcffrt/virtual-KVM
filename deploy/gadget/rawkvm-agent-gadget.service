# RawKVM USB gadget agent. Root: it writes ConfigFS and /dev/hidgN.
# If the PC on the USB cable runs Linux, add --host-os linux --no-hidpp to
# ExecStart (ADR 0007); for a Mac, --host-os macos. The default is Windows.
[Unit]
Description=RawKVM USB gadget agent (receiver over USB)
Wants=network-online.target
After=network-online.target sys-kernel-config.mount
Requires=sys-kernel-config.mount

[Service]
Type=simple
# --udc-wait: wait up to 60 s for the USB device controller (dwc2 / musb
# may probe after the service starts).
ExecStart=/usr/local/bin/rawkvm-agent-gadget --config /etc/rawkvm/agent.toml --udc-wait 60
Restart=always
RestartSec=2
Nice=-10

[Install]
WantedBy=multi-user.target
