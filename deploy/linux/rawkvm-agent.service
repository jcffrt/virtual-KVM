# RawKVM agent, systemd user unit (/usr/lib/systemd/user/). Enabled per
# user by `rawkvm-agent setup`. Needs /dev/uhid: see 70-rawkvm-uhid.rules.
[Unit]
Description=RawKVM agent (virtual HID devices via uhid)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/rawkvm-agent
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
