#!/bin/sh
# postrm of rawkvm-hub. `remove` keeps the config, the token and the
# certificate; only `purge` deletes them. /etc/rawkvm is shared with
# rawkvm-agent-gadget (agent.toml): delete only the hub's files.
set -e
case "$1" in
purge)
    rm -f /etc/rawkvm/hub.toml /etc/rawkvm/hub.tmp
    rm -rf /var/lib/rawkvm /var/lib/rawkvm-netwatch
    # Enabled without systemd running (prerm could not disable it then).
    rm -f /etc/systemd/system/multi-user.target.wants/rawkvm-netwatch.service
    rmdir /etc/rawkvm 2>/dev/null || true
    mount=/etc/systemd/system/var-log-journal.mount
    if [ -f "$mount" ] && grep -q RawKVM "$mount"; then
        if [ -d /run/systemd/system ]; then
            systemctl disable var-log-journal.mount >/dev/null 2>&1 || true
        fi
        rm -f "$mount"
    fi
    # Undo the journal excludes of postinst in the ramlog settings.
    for conf in /etc/default/armbian-ramlog /etc/default/orangepi-ramlog; do
        if ! [ -f "$conf" ] || ! grep -q '# rawkvm-hub' "$conf"; then
            continue
        fi
        tmp=$(mktemp "$conf.XXXXXX")
        awk '
            index($0, "# rawkvm-hub was: ") == 1 { was = substr($0, 19); next }
            / # rawkvm-hub$/ { if (was != "") print was; was = ""; next }
            { print }' "$conf" > "$tmp" && cat "$tmp" > "$conf"
        rm -f "$tmp"
    done
    echo "rawkvm-hub: purged the pairing token and the certificate; every agent must pair again with the next hub"
    ;;
esac
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
exit 0
