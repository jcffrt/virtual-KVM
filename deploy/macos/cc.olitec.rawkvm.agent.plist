<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- RawKVM agent. Runs as root: the Karabiner daemon socket is root-only. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>cc.olitec.rawkvm.agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/rawkvm-agent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <!-- Input forwarding must not be deprioritized. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/log/rawkvm-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/rawkvm-agent.log</string>
  </dict>
</plist>
